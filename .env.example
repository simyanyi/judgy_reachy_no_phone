# Reachy Mini Wireless daemon. Use its IP to avoid relying on mDNS discovery.
REACHY_MINI_HOST=reachy-mini.local
# The Control app uses 8042 on macOS. Set 8043 there; DGX can keep 8042.
JUDGY_APP_PORT=8042
# Use "random" to choose once at startup, or a personality ID such as "sarcastic".
DEFAULT_PERSONALITY=random


KOKORO_PRELOAD=true
KOKORO_MODEL_ID=hexgrad/Kokoro-82M
KOKORO_LANGUAGE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
# Keep downloaded model weights inside this project (ignored by git).
HF_HOME=.cache/huggingface
HF_TOKEN=XXX

FACE_TRACKING_ENABLED=true
FACE_TRACKING_CONFIDENCE=0.3
FACE_TRACKING_MODEL_REPO=AdamCodd/YOLOv11n-face-detection
FACE_TRACKING_MODEL_FILE=model.pt
FACE_TRACKING_DEVICE=cpu
# FACE_TRACKING_DEVICE=cuda:0
