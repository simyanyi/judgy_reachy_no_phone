# Reachy Mini Wireless daemon. Use its IP to avoid relying on mDNS discovery.
REACHY_MINI_HOST=192.168.50.200

# All inference runs locally. OmniVoice downloads once on first use; set this
# to a local model folder afterwards to prevent any future model download.
OMNIVOICE_MODEL_PATH=k2-fsa/OmniVoice
OMNIVOICE_REFERENCE_AUDIO=judgy_reachy_no_phone/assets/voice_reference.wav
# Exact spoken words in voice_reference.wav. This is required for cloning.
OMNIVOICE_REFERENCE_TEXT=Hello! I'm your warm and cheerful Reachy companion.

FACE_TRACKING_ENABLED=true
FACE_TRACKING_CONFIDENCE=0.6
